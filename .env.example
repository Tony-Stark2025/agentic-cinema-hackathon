# Google Cloud Vertex AI Configuration (Gemini Enterprise Agent Platform)
# On Google Cloud Run, authentication is automatic via Application Default Credentials (ADC).
GOOGLE_CLOUD_PROJECT=gen-lang-client-0942141479
GOOGLE_CLOUD_REGION=us-central1
GEMINI_MODEL=gemini-3.8-flash

# Optional: Local API Key fallback if testing outside GCP without gcloud ADC
GEMINI_API_KEY=

# Grafana Cloud Configuration (Optional: Showrunner includes built-in Studio Telemetry Harness)
GRAFANA_CLOUD_URL=https://your-stack.grafana.net
GRAFANA_SERVICE_TOKEN=glsa_your_service_account_token
GRAFANA_MCP_ENDPOINT=https://mcp.grafana.com/mcp

# Studio Stage & Observability
SHOWRUNNER_STAGE=STG-VIRTUAL-STAGE-A
ENABLE_OTEL_OBSERVABILITY=true
